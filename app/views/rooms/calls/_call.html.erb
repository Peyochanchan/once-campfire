<div class="call-container"
     data-controller="video-call"
     data-video-call-token-value="<%= token %>"
     data-video-call-url-value="<%= Rails.configuration.x.livekit.url %>"
     data-video-call-room-id-value="<%= room.id %>"
     data-video-call-leave-url-value="<%= room_call_path(room) %>"
     data-video-call-avatar-url-value="<%= fresh_user_avatar_path(Current.user) %>"
     data-video-call-start-with-video-value="<%= video %>"
     data-video-call-label-ended-value="<%= t("calls.ended") %>"
     data-video-call-label-back-value="<%= t("calls.back_to_room") %>"
     data-video-call-label-close-value="<%= t("common.close_tab") %>"
     data-video-call-label-spotlight-value="<%= t("calls.spotlight") %>"
     data-video-call-label-unspotlight-value="<%= t("calls.unspotlight") %>">

  <div class="call-prejoin" data-video-call-target="prejoinPanel">
    <div class="call-prejoin__preview">
      <video data-video-call-target="prejoinVideo" autoplay muted playsinline></video>
      <div class="call-prejoin__placeholder" data-video-call-target="prejoinPlaceholder" style="display:none">
        <img src="<%= fresh_user_avatar_path(Current.user) %>" alt="" />
      </div>
    </div>

    <div class="call-prejoin__panel">
      <h1 class="call-prejoin__title"><%= t("calls.prejoin.title", room: room.name) %></h1>
      <p class="call-prejoin__hint" data-video-call-target="prejoinHint"><%= t("calls.prejoin.hint") %></p>

      <div class="call-prejoin__toggles">
        <button class="btn call-btn" type="button" data-action="video-call#togglePrejoinCamera" data-video-call-target="prejoinCamBtn" aria-label="<%= t("calls.toggle_camera") %>">
          <span class="icon-on"><%= lucide_icon "camera", size: 22 %></span>
          <span class="icon-off" style="display:none"><%= lucide_icon "camera-off", size: 22 %></span>
        </button>
        <button class="btn call-btn" type="button" data-action="video-call#togglePrejoinMic" data-video-call-target="prejoinMicBtn" aria-label="<%= t("calls.toggle_mic") %>">
          <span class="icon-on"><%= lucide_icon "mic", size: 22 %></span>
          <span class="icon-off" style="display:none"><%= lucide_icon "mic-off", size: 22 %></span>
        </button>
        <button class="btn call-btn" type="button" data-action="video-call#togglePrejoinBlur" data-video-call-target="prejoinBlurBtn" aria-label="<%= t("calls.background_blur") %>">
          <%= lucide_icon "user-round", size: 22 %>
        </button>
        <div class="call-prejoin__vu" data-video-call-target="prejoinVu" aria-hidden="true">
          <div class="call-prejoin__vu-fill" data-video-call-target="prejoinVuFill"></div>
        </div>
      </div>

      <div class="call-prejoin__devices">
        <label class="call-prejoin__device">
          <span><%= t("calls.camera") %></span>
          <select data-video-call-target="prejoinCamSelect" data-action="change->video-call#switchPrejoinCamera" class="call-prejoin__select"></select>
        </label>
        <label class="call-prejoin__device">
          <span><%= t("calls.microphone") %></span>
          <select data-video-call-target="prejoinMicSelect" data-action="change->video-call#switchPrejoinMic" class="call-prejoin__select"></select>
        </label>
        <label class="call-prejoin__device" data-video-call-target="prejoinSpkLabel">
          <span><%= t("calls.speaker") %></span>
          <select data-video-call-target="prejoinSpkSelect" data-action="change->video-call#switchPrejoinSpeaker" class="call-prejoin__select"></select>
        </label>
      </div>

      <div class="call-prejoin__actions">
        <button class="btn call-prejoin__cancel" type="button" data-action="video-call#cancelPrejoin"><%= t("calls.prejoin.cancel") %></button>
        <button class="btn call-prejoin__join" type="button" data-action="video-call#joinFromPrejoin" data-video-call-target="prejoinJoinBtn"><%= t("calls.prejoin.join") %></button>
      </div>
    </div>
  </div>

  <div class="call-grid" data-video-call-target="grid" style="display:none">
  </div>

  <div class="call-settings" data-video-call-target="settingsPanel" style="display:none">
    <div class="call-settings__inner">
      <div class="call-settings__header">
        <strong><%= t("calls.settings_title") %></strong>
        <button class="call-settings__close" data-action="video-call#toggleSettings">&times;</button>
      </div>
      <label class="call-settings__label"><%= t("calls.camera") %></label>
      <select data-video-call-target="cameraSelect" data-action="change->video-call#switchCamera" class="call-settings__select"></select>

      <label class="call-settings__label"><%= t("calls.microphone") %></label>
      <select data-video-call-target="micSelect" data-action="change->video-call#switchMic" class="call-settings__select"></select>

      <label class="call-settings__label"><%= t("calls.speaker") %></label>
      <select data-video-call-target="speakerSelect" data-action="change->video-call#switchSpeaker" class="call-settings__select"></select>
    </div>
  </div>

  <div class="call-chat-sidebar" data-video-call-target="chatPanel" style="display:none">
    <div class="call-chat-sidebar__header">
      <strong><%= t("calls.chat") %></strong>
      <button class="call-chat-sidebar__close" data-action="video-call#toggleChat">&times;</button>
    </div>
    <iframe src="<%= room_chat_embed_path(room) %>" class="call-chat-sidebar__iframe"></iframe>
  </div>

  <div class="call-controls" data-video-call-target="controlsBar" style="display:none">
    <button class="btn call-btn" data-action="video-call#toggleCamera" data-video-call-target="cameraBtn" type="button" title="<%= t("calls.toggle_camera") %>" aria-label="<%= t("calls.toggle_camera") %>">
      <span class="icon-on"><%= lucide_icon "camera", size: 22 %></span>
      <span class="icon-off" style="display:none"><%= lucide_icon "camera-off", size: 22 %></span>
    </button>

    <button class="btn call-btn" data-action="video-call#toggleMic" data-video-call-target="micBtn" type="button" title="<%= t("calls.toggle_mic") %>" aria-label="<%= t("calls.toggle_mic") %>">
      <span class="icon-on"><%= lucide_icon "mic", size: 22 %></span>
      <span class="icon-off" style="display:none"><%= lucide_icon "mic-off", size: 22 %></span>
    </button>

    <button class="btn call-btn" data-action="video-call#toggleBlur" data-video-call-target="blurBtn" type="button" title="<%= t("calls.background_blur") %>" aria-label="<%= t("calls.background_blur") %>">
      <%= lucide_icon "user-round", size: 22 %>
    </button>

    <button class="btn call-btn" data-action="video-call#toggleScreenShare" data-video-call-target="screenBtn" type="button" title="<%= t("calls.share_screen") %>" aria-label="<%= t("calls.share_screen") %>">
      <span class="icon-on"><%= lucide_icon "screen-share", size: 22 %></span>
      <span class="icon-off" style="display:none"><%= lucide_icon "screen-share-off", size: 22 %></span>
    </button>

    <button class="btn call-btn" data-action="video-call#toggleChat" data-video-call-target="chatBtn" type="button" title="<%= t("calls.chat") %>" aria-label="<%= t("calls.chat") %>">
      <%= lucide_icon "message-square", size: 22 %>
    </button>

    <button class="btn call-btn" data-action="video-call#togglePip" data-video-call-target="pipBtn" type="button" title="<%= t("calls.pip") %>" aria-label="<%= t("calls.pip") %>">
      <%= lucide_icon "picture-in-picture-2", size: 22 %>
    </button>

    <button class="btn call-btn" data-action="video-call#toggleSettings" data-video-call-target="settingsBtn" type="button" title="<%= t("calls.settings_title") %>" aria-label="<%= t("calls.settings_title") %>">
      <%= lucide_icon "settings", size: 22 %>
    </button>

    <button class="btn call-btn call-btn--leave" data-action="video-call#leave" type="button" title="<%= t("calls.leave_call") %>" aria-label="<%= t("calls.leave_call") %>">
      <%= lucide_icon "phone", size: 22 %>
    </button>
  </div>
</div>
